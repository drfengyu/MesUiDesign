<?xml version="1.0" encoding="utf-8"?>
<!--
  日志目录用 %property{LogDir}，由 Mes.Common.LogHelper 在启动时设成 exe 目录下的 Logs。
  这里不要写死绝对路径：换一台机器所有 appender 都写不出去，而 log4net 写失败是一句不响的，
  出事后翻目录才发现是空的。
  只留两个 appender：主日志收全部，通讯流水只收 PLC读/PLC写。
  不要预先摆 PDCA/OEE/Trace 这种"代码里还不产生"的类别，留着只会让人以为已经有那本账。
-->
<log4net>
  <!-- 主日志：操作、异常、启动自检，一天一个文件 -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}/操作日志/log" />
    <datePattern value="'_'yyyyMMdd'.txt'" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <encoding value="utf-8" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level - %message%newline" />
    </layout>
  </appender>

  <!-- 通讯流水：只收 LogHelper.PlcTrace 出来的那几行，排查"这个地址到底发没发出去"时单独看这本 -->
  <appender name="PlcFileAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}/通讯流水/plc" />
    <datePattern value="'_'yyyyMMdd'.txt'" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <encoding value="utf-8" />
    <filter type="log4net.Filter.StringMatchFilter">
      <stringToMatch value="PLC读 " />
    </filter>
    <filter type="log4net.Filter.StringMatchFilter">
      <stringToMatch value="PLC写 " />
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level - %message%newline" />
    </layout>
  </appender>

  <root>
    <level value="All" />
    <appender-ref ref="RollingFileAppender" />
    <appender-ref ref="PlcFileAppender" />
  </root>
</log4net>
